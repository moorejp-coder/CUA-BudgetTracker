# Copy to .env and adjust as needed.

ENV=development

# sqlite:///./data/app.db  (default)  — or postgresql+psycopg2://user:pass@postgres:5432/budget_tracker
DATABASE_URL=sqlite:///./data/app.db

# Generate a real one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-please

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Local LLM (OpenAI-compatible endpoint). Set LLM_ENABLED=false to disable the assistant,
# recap/nudge phrasing, and CSV-categorization LLM calls — every feature falls back to a
# deterministic rule-based/templated equivalent, nothing breaks.
LLM_ENABLED=true
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=not-needed

# Weekly/monthly recaps + daily nudge evaluation, run in-process via APScheduler. Leave
# false for dev (`--reload` spins up multiple workers, which would double-schedule jobs) —
# turn on for a real single-process deployment.
SCHEDULER_ENABLED=false
