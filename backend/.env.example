# Copy to .env and adjust as needed.

ENV=development

# sqlite:///./data/app.db  (default)  — or postgresql+psycopg2://user:pass@postgres:5432/budget_tracker
DATABASE_URL=sqlite:///./data/app.db

# Generate a real one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-please

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# LLM provider. Set LLM_ENABLED=false to disable the assistant, recap/nudge phrasing, and
# CSV-categorization LLM calls entirely — every feature falls back to a deterministic
# rule-based/templated equivalent, nothing breaks.
LLM_ENABLED=true
LLM_PROVIDER=local

# provider=local: OpenAI-compatible endpoint (Ollama, LM Studio, vLLM's OpenAI server).
# Financial data never leaves this machine.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=not-needed

# provider=claude: Anthropic API. Financial data in prompts is sent to Anthropic — only
# use this if that tradeoff is acceptable for your deployment. Get a key at
# console.anthropic.com and set a spend cap there.
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# Weekly/monthly recaps + daily nudge evaluation, run in-process via APScheduler. Leave
# false for dev (`--reload` spins up multiple workers, which would double-schedule jobs) —
# turn on for a real single-process deployment.
SCHEDULER_ENABLED=false
