# Copy to .env (same directory as docker-compose.yml) and adjust.
# docker compose reads this automatically for ${DOMAIN} substitution in docker-compose.yml.

# Public hostname Caddy will request a Let's Encrypt certificate for and serve HTTPS on.
# Must be a real, publicly resolvable domain pointing at this host (e.g. your DuckDNS name).
DOMAIN=jamesbudget.duckdns.org
